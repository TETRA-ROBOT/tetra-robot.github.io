{
  "//": "데모 코드 타입 검사용 (빌드에는 쓰지 않음): ../../.upstream/fleet/tetra-fleet-ui/node_modules/.bin/tsc -p demos/fleet",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@fleet-api/*": ["../../.upstream/fleet/tetra-fleet-api/src/*"],
      "@fleet-ui/*": ["./shims/fleet-ui.d.ts"],
      "axios": ["../../.upstream/fleet/tetra-fleet-ui/node_modules/axios/index.d.ts"]
    }
  },
  "include": ["*.ts", "mock/*.ts", "shims/*.ts"],
  "exclude": ["vite.config.ts"]
}
